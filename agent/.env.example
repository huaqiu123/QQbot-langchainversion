# ============================================================
# Small Agent 后端配置示例
# 复制为 .env 后按需修改：cp .env.example .env
# ============================================================

# ---------- DeepSeek（必填）----------
# 申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
# 只支持工具调用的模型是 deepseek-chat（V3）
# 切勿改成 deepseek-reasoner（R1 不支持 function calling，Agent 会失效）
DEEPSEEK_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# ---------- 搜索 ----------
# duckduckgo（免 Key） | tavily | serper
SEARCH_PROVIDER=duckduckgo
SEARCH_TOP_K=5
SEARCH_TIMEOUT=15
# ddgs 是元搜索库，可指定后端并自动降级；国内网络下 duckduckgo/startpage 常不可达，
# 因此默认把 bing、brave 排在前面。可选：bing | brave | duckduckgo | google | mojeek | yahoo | yandex | wikipedia
DDGS_BACKENDS=bing,brave,duckduckgo
TAVILY_API_KEY=
SERPER_API_KEY=

# ---------- Agent ----------
RECURSION_LIMIT=12
MAX_HISTORY_MESSAGES=10
REQUEST_TIMEOUT=120

# ---------- 知识库（RAG V2）----------
# SiliconFlow Embedding API Key（https://siliconflow.cn）
# 留空则不启用知识库功能
EMBEDDING_API_KEY=
# Embedding 模型名（SiliconFlow 上可用的模型）
EMBEDDING_MODEL=BAAI/bge-m3
# Embedding API 基础地址（SiliconFlow 兼容 OpenAI 格式）
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# Chroma 持久化目录
CHROMA_PERSIST_DIR=data/chroma
# SQLite 消息存储路径
KNOWLEDGE_DB_PATH=data/knowledge.db
# 相似度阈值：低于此值的结果不注入 prompt
KNOWLEDGE_SIMILARITY_THRESHOLD=0.7
# 检索返回最大结果数
KNOWLEDGE_SEARCH_TOP_K=5
# 文本分块大小（字符数）
KNOWLEDGE_CHUNK_SIZE=256
# 文本分块重叠字符数
KNOWLEDGE_CHUNK_OVERLAP=32

# ---------- 服务 ----------
# 留空则不校验；填了之后调用方需带 X-API-Key 请求头（供后续 NapCat 对接使用）
AGENT_API_KEY=
HOST=0.0.0.0
PORT=8000

# ---------- 可选：LangSmith 链路追踪 ----------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=small-agent